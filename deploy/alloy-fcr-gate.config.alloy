loki.source.journal "fcr_gate" {
	matches    = "_SYSTEMD_UNIT=fcr-rfid-encoder.service"
	max_age    = "168h"
	labels     = {service_name = "fcr-gate"}
	forward_to = [loki.process.fcr_gate.receiver]
}

loki.process "fcr_gate" {
	stage.json {
		expressions = {
			level    = "level",
			event    = "event",
			mode     = "mode",
			decision = "decision",
		}
	}

	// These fields have a small, controlled value set. TIDs, EPCs, plates, user
	// IDs, and error text stay in the JSON body to avoid high-cardinality labels.
	stage.labels {
		values = {
			level    = "",
			event    = "",
			mode     = "",
			decision = "",
		}
	}

	forward_to = [loki.write.homelab.receiver]
}

loki.write "homelab" {
	external_labels = {
		host = sys.env("FCR_GATE_HOST"),
		site = sys.env("FCR_GATE_SITE"),
	}

	endpoint {
		url = sys.env("FCR_GATE_LOKI_URL")
	}

	wal {
		enabled         = true
		max_segment_age = "168h"
	}
}
