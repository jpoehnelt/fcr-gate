# Non-secret gateway service configuration. Store the real file under
# /data/fcr-gate/secrets/gateway.env with mode 0600.

# JSON event verbosity. Keep info enabled to record one event per RFID passage.
RUST_LOG=info

# Best-effort remote copy of the same JSON records retained in journald. Loki
# failures never block RFID processing. Leave the URL empty to disable delivery.
FCR_GATE_LOKI_URL=http://loki.tail1f002.ts.net:3100/loki/api/v1/push
FCR_GATE_HOST=falls-creek-ranch-gate
FCR_GATE_SITE=falls-creek-ranch

IMPINJ_HOST=https://192.168.10.229
IMPINJ_USERNAME=root
IMPINJ_PASSWORD_FILE=/data/fcr-gate/secrets/impinj-password
IMPINJ_TLS_VERIFY=false
# The inventory preset is externally owned; the service only streams it and
# never installs, starts, or stops presets. Only events from this antenna port
# count as discovery observations.
IMPINJ_ANTENNA_PORT=1

RFID_STATE_DB=/data/fcr-gate/rfid-encoder.sqlite3
RFID_SERVICE_ACTOR=gate-auto

FCR_GATE_WEB_BIND=127.0.0.1
FCR_GATE_WEB_PORT=8080

# Minimal process/reader/database health endpoint at /healthz. It contains no tag
# or user data.
FCR_GATE_HEALTH_ENABLED=true
FCR_GATE_HEALTH_STALE_MS=120000

# UniFi Access is the source of truth for users, Entry Gate policies, and schedules.
# The API token needs view:user, view:policy, view:space, and edit:space.
UNIFI_ACCESS_HOST=https://100.89.168.42:12445
UNIFI_API_KEY_FILE=/data/fcr-gate/secrets/unifi-access-api-key
UNIFI_TLS_VERIFY=false
UNIFI_ENTRY_GATE_DOOR_ID=1b620b81-f457-45f7-9fd2-27de1d8c4fdc

# Multi-visit discovery learns resident tags without modifying them. It uses TID
# when available and a stable EPC fallback otherwise. Keep disabled until
# dry-run evidence has been reviewed with `fcr-rfid-encoder discovery-status`.
RFID_DISCOVERY_MODE=disabled
RFID_DISCOVERY_MATCH_WINDOW_MS=10000
RFID_DISCOVERY_POLL_MS=2000
RFID_DISCOVERY_PASSAGE_GAP_MS=30000
RFID_DISCOVERY_MAX_DWELL_MS=120000
RFID_DISCOVERY_MIN_RSSI_CDBM=-6000
RFID_DISCOVERY_MIN_OCCURRENCES=3
RFID_DISCOVERY_MIN_DAYS=2
RFID_DISCOVERY_MIN_CONFIDENCE_PERCENT=80
RFID_DISCOVERY_CONFLICT_OCCURRENCES=2
RFID_DISCOVERY_EVIDENCE_DAYS=60
RFID_DISCOVERY_LEASE_DAYS=60

# Gate authorization is independent from discovery. Use dry-run to run
# and audit every UniFi check without sending a door-unlock command.
RFID_GATE_MODE=disabled
RFID_GATE_UNLOCK_COOLDOWN_MS=30000

# UniFi weekly schedules are evaluated in the process's local timezone.
TZ=America/Denver
